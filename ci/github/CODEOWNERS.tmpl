# agentic-dev-kit: paths that define what "passing" means, or record verdicts.
# With branch protection's "Require review from Code Owners", a human must approve any
# change to them, whatever the agents do.
.agentic/kit/                  {owners}
.agentic/locks/                {owners}
.agentic/config.toml           {owners}
.agentic/CODING_STANDARDS.md   {owners}
.agentic/specs/                {owners}
.github/workflows/             {owners}
.github/CODEOWNERS             {owners}
.github/dependabot.yml         {owners}
.claude/settings.json          {owners}
.devcontainer/                 {owners}
